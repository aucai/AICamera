<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <com.aucai.aicamera.ui.GuideOverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/white" />

    <TextView
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:shadowColor="#AA000000"
        android:shadowRadius="12"
        android:textColor="@android:color/white"
        android:textSize="96sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnGrid"
                style="@style/ToolButton"
                app:drawableTopCompat="@drawable/ic_grid" />

            <TextView
                android:id="@+id/btnCrop"
                style="@style/ToolButton"
                app:drawableTopCompat="@drawable/ic_crop" />

            <TextView
                android:id="@+id/btnTimer"
                style="@style/ToolButton"
                app:drawableTopCompat="@drawable/ic_timer" />

            <TextView
                android:id="@+id/btnVoice"
                style="@style/ToolButton"
                app:drawableTopCompat="@drawable/ic_voice_on" />
        </LinearLayout>

        <TextView
            android:id="@+id/sceneChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reasonChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <include
            android:id="@+id/tip1"
            layout="@layout/view_tip" />

        <include
            android:id="@+id/tip2"
            layout="@layout/view_tip" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/exposureRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#990E0E10"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/exposureLabel"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:labelFor="@+id/exposureSeek"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/exposureSeek"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:contentDescription="@string/exposure" />
        </LinearLayout>

        <TextView
            android:id="@+id/captureNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/checkList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/modeTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/tabSmart"
                style="@style/ModeTab" />

            <TextView
                android:id="@+id/tabComposition"
                style="@style/ModeTab" />

            <TextView
                android:id="@+id/tabPose"
                style="@style/ModeTab" />

            <TextView
                android:id="@+id/tabLight"
                style="@style/ModeTab" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:paddingStart="36dp"
            android:paddingEnd="36dp">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_thumb"
                android:clipToOutline="true"
                android:contentDescription="@string/gallery"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <com.aucai.aicamera.ui.ShutterButton
                android:id="@+id/shutter"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center" />

            <ImageButton
                android:id="@+id/btnSwitch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_round"
                android:contentDescription="@string/switch_camera"
                android:src="@drawable/ic_switch_camera" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permission_needed"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/grant_permission" />
    </LinearLayout>
</FrameLayout>
